cabal-version: 3.16

name: haskell-api
version: 0.1.0.0
license: NONE
author: h-waji (hamltail)
build-type: Simple

extra-doc-files:
    README.md

common warnings
    ghc-options: -Wall

library
    import: warnings

    exposed-modules:
        App

    hs-source-dirs:
        src

    build-depends:
        aeson,
        base ^>=4.20.2.0,
        http-types,
        scientific,
        scotty,
        text

    default-language: Haskell2010

executable haskell-api
    import: warnings

    main-is: Main.hs

    hs-source-dirs:
        app

    build-depends:
        aeson,
        base ^>=4.20.2.0,
        haskell-api,
        scotty

    ghc-options:
        -threaded
        -rtsopts
        -with-rtsopts=-N

    default-language: Haskell2010

test-suite haskell-api-test
    import: warnings

    type: exitcode-stdio-1.0
    main-is: Spec.hs

    hs-source-dirs:
        test

    build-depends:
        aeson,
        base ^>=4.20.2.0,
        haskell-api,
        hspec,
        hspec-wai,
        http-types,
        scotty

    default-language: Haskell2010
