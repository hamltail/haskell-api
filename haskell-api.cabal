cabal-version: 3.16

name: haskell-api
version: 0.1.0.0
license: NONE
author: h-waji (hamltail)
build-type: Simple

extra-doc-files:
    README.md

common warnings
    ghc-options: -Wall

executable haskell-api
    import: warnings

    main-is: Main.hs
    hs-source-dirs: app

    other-extensions:
        OverloadedStrings

    build-depends:
        aeson,
        base ^>=4.20.2.0,
        scotty,
        text

    ghc-options:
        -threaded
        -rtsopts
        -with-rtsopts=-N

    default-language: Haskell2010
