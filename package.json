{
  "name": "haskell-api",
  "version": "0.1.0",
  "private": true,
  "description": "Take silly things seriously.",
  "author": "h-waji (hamltail)",
  "license": "UNLICENSED",
  "scripts": {
    "examples": "for file in examples/*.hs; do echo \"=== $file ===\"; runghc \"$file\"; done",
    "ex1": "runghc examples/01-basics.hs",
    "ex2": "runghc examples/02-functions.hs",
    "ex3": "runghc examples/03-lists.hs",
    "ex4": "runghc examples/04-pattern-matching.hs",
    "ex5": "runghc examples/05-types.hs",
    "ex6": "runghc examples/06-io.hs",
    "format:haskell": "ormolu --mode inplace examples/*.hs",
    "format:markdown": "prettier --write \"**/*.md\"",
    "format": "npm run format:haskell && npm run format:markdown",
    "format:check": "ormolu --mode check examples/*.hs",
    "lint": "hlint examples",
    "check": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
