{
  "name": "haskell-api",
  "version": "0.1.0",
  "private": true,
  "description": "Take silly things seriously.",
  "author": "h-waji (hamltail)",
  "license": "UNLICENSED",
  "scripts": {
    "examples": "for file in examples/*.hs; do echo \"=== $file ===\"; runghc \"$file\"; done",
    "format": "ormolu --mode inplace examples/*.hs",
    "format:check": "ormolu --mode check examples/*.hs",
    "lint": "hlint examples",
    "check": "npm run format:check && npm run lint"
  }
}
